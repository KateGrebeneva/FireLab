# FireLab в Docker. Не редактируйте этот файл — выполните `node docker/keys.mjs`,
# он создаст .env с секретами, и впишите в .env данные администратора.

# Порт сайта на компьютере-сервере: http://<IP-компьютера>:8080
HTTP_PORT=8080
# Адрес, по которому открывают сайт (используется Auth для ссылок и как издатель токенов)
SITE_URL=http://localhost:8080

# Первый администратор (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
# true — при следующем запуске пароль администратора будет сброшен на ADMIN_PASSWORD
ADMIN_RESET=false

# Время жизни сессии, секунд (обновляется автоматически)
JWT_EXPIRY=3600

# ---- Секреты: генерирует docker/keys.mjs, никому не передавайте ----
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
