# ---------- Frontend (нужны и локально, и в Vercel) ----------
# Project Settings → General → Project ID
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys: "anon public" (или Publishable key sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# ---------- Только для npm run seed (НЕ добавлять в Vercel, НЕ коммитить) ----------
# Project Settings → API Keys: "service_role" (или Secret key sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# необязательно: ФИО администратора, например «Иванов Иван Иванович»
ADMIN_FULL_NAME=
